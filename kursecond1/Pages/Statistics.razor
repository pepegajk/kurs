@page "/statistics"
@inject ApiService ApiService
@inject UserSettingsService SettingsService
@inject IJSRuntime JS

<PageTitle>Статистика - AutoMarket</PageTitle>

<div class="page-header">
    <h1><span class="bi bi-graph-up"></span> Статистика и аналитика</h1>
    <button class="btn btn-primary" @onclick="ExportReport">
        <span class="bi bi-file-earmark-pdf"></span> Экспорт отчёта
    </button>
</div>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
        <p class="mt-2">Загрузка статистики...</p>
    </div>
}
else if (statistics != null)
{
    <!-- Общая статистика -->
    <div class="stats-overview">
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="stat-card primary">
                    <div class="stat-icon"><span class="bi bi-car-front"></span></div>
                    <div class="stat-content">
                        <h3>@statistics.TotalCars</h3>
                        <p>Всего автомобилей</p>
                        <small class="text-success">@statistics.ActiveCars активных</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card success">
                    <div class="stat-icon"><span class="bi bi-clipboard-check"></span></div>
                    <div class="stat-content">
                        <h3>@statistics.TotalDeals</h3>
                        <p>Всего сделок</p>
                        <small class="text-success">@statistics.CompletedDeals завершено</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card warning">
                    <div class="stat-icon"><span class="bi bi-currency-exchange"></span></div>
                    <div class="stat-content">
                        <h3>@SettingsService.FormatPrice(statistics.TotalRevenue)</h3>
                        <p>Общая выручка</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card info">
                    <div class="stat-icon"><span class="bi bi-graph-up-arrow"></span></div>
                    <div class="stat-content">
                        <h3>@SettingsService.FormatPrice(statistics.AverageCarPrice)</h3>
                        <p>Средняя цена</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- График сделок по месяцам -->
    @if (statistics.DealsByMonth?.Any() == true)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="chart-card">
                    <h4><span class="bi bi-graph-up"></span> Сделки по месяцам</h4>
                    <div style="position: relative; height: 400px;">
                        <canvas id="dealsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Простая аналитика -->
    <div class="row">
        <div class="col-lg-6">
            <div class="table-card">
                <h4><span class="bi bi-list-ol"></span> Топ бренды</h4>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Бренд</th>
                            <th class="text-end">Количество</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (statistics.TopBrands?.Any() == true)
                        {
                            @foreach (var brand in statistics.TopBrands.Take(10))
                            {
                                <tr>
                                    <td>@brand.BrandName</td>
                                    <td class="text-end"><strong>@brand.Count</strong></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="text-center text-muted">Нет данных</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="table-card">
                <h4><span class="bi bi-calendar-month"></span> Продажи по месяцам</h4>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Месяц</th>
                            <th class="text-end">Сделок</th>
                            <th class="text-end">Выручка</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (statistics.DealsByMonth?.Any() == true)
                        {
                            @foreach (var month in statistics.DealsByMonth.Take(12))
                            {
                                <tr>
                                    <td>@FormatMonthLabel(month.MonthFormatted)</td>
                                    <td class="text-end"><strong>@month.Count</strong></td>
                                    <td class="text-end">@SettingsService.FormatPrice(month.Revenue)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted">Нет данных</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-lg-6">
            <div class="table-card">
                <h4><span class="bi bi-bar-chart-steps"></span> Авто по ценам</h4>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Диапазон</th>
                            <th class="text-end">Количество</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (statistics.CarsByPriceRange?.Any() == true)
                        {
                            @foreach (var range in statistics.CarsByPriceRange)
                            {
                                <tr>
                                    <td>@range.Range</td>
                                    <td class="text-end"><strong>@range.Count</strong></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="text-center text-muted">Нет данных</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span> @(loadError ?? "Не удалось загрузить статистику.")
    </div>
}

@code {
    private StatisticsDto? statistics;
    private bool isLoading = true;
    private string? loadError;
    private bool shouldRenderChart = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadStatistics();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldRenderChart && statistics?.DealsByMonth?.Any() == true)
        {
            shouldRenderChart = false;
            // Небольшая задержка для гарантированного рендеринга DOM
            await Task.Delay(50);
            await RenderDealsChart();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadStatistics()
    {
        isLoading = true;
        loadError = null;
        statistics = await ApiService.GetStatisticsAsync();
        if (statistics == null)
        {
            statistics = await BuildStatisticsFromDataAsync();
            if (statistics == null)
            {
                loadError = "Не удалось загрузить статистику. Проверь доступ и работу API.";
            }
        }
        isLoading = false;
        
        if (statistics?.DealsByMonth?.Any() == true)
        {
            shouldRenderChart = true;
        }
    }

    private async Task RenderDealsChart()
    {
        if (statistics?.DealsByMonth == null) 
        {
            Console.WriteLine("RenderDealsChart: statistics or DealsByMonth is null");
            return;
        }

        try
        {
            var dealsByMonth = statistics.DealsByMonth.Take(12).ToList();
            if (!dealsByMonth.Any())
            {
                Console.WriteLine("RenderDealsChart: No deals by month data");
                return;
            }

            var monthLabels = dealsByMonth.Select(d => FormatMonthLabel(d.MonthFormatted)).ToArray();
            var dealsCount = dealsByMonth.Select(d => d.Count).ToArray();
            var revenue = dealsByMonth.Select(d => (double)d.Revenue).ToArray();
            
            Console.WriteLine($"RenderDealsChart: Labels count={monthLabels.Length}, Deals count={dealsCount.Length}, Revenue count={revenue.Length}");
            
            if (monthLabels.Length > 0 && dealsCount.Length > 0)
            {
                // Проверяем, что функция существует, и ждём если её нет
                for (int i = 0; i < 10; i++)
                {
                    try
                    {
                        var funcExists = await JS.InvokeAsync<bool>("eval", "typeof window.renderDealsChart !== 'undefined'");
                        if (funcExists)
                        {
                            await Task.Delay(50); // Небольшая задержка для рендеринга DOM
                            await JS.InvokeVoidAsync("renderDealsChart", "dealsChart", monthLabels, dealsCount, revenue);
                            Console.WriteLine("RenderDealsChart: Chart rendered successfully");
                            return;
                        }
                    }
                    catch
                    {
                        // Игнорируем ошибки проверки
                    }
                    await Task.Delay(100);
                }
                
                // Если функция так и не появилась, пытаемся вызвать напрямую
                try
                {
                    await JS.InvokeVoidAsync("window.renderDealsChart", "dealsChart", monthLabels, dealsCount, revenue);
                    Console.WriteLine("RenderDealsChart: Chart rendered via window.renderDealsChart");
                }
                catch (Exception ex2)
                {
                    Console.WriteLine($"RenderDealsChart: Failed to call function - {ex2.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering deals chart: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
    }

    private string FormatMonthLabel(string monthStr)
    {
        // Преобразуем "2025-06" в "Июнь 2025"
        if (monthStr.Length >= 7 && monthStr.Contains('-'))
        {
            var parts = monthStr.Split('-');
            if (parts.Length == 2 && int.TryParse(parts[1], out int month))
            {
                var monthNames = new[] { "", "Янв", "Фев", "Мар", "Апр", "Май", "Июн", "Июл", "Авг", "Сен", "Окт", "Ноя", "Дек" };
                if (month >= 1 && month <= 12)
                {
                    return $"{monthNames[month]} {parts[0]}";
                }
            }
        }
        return monthStr;
    }

    private async Task<StatisticsDto?> BuildStatisticsFromDataAsync()
    {
        try
        {
            var cars = await ApiService.GetCarsAsync();
            var deals = await ApiService.GetDealsAsync();

            var completedDeals = deals
                .Where(d => string.Equals(d.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                .ToList();

            var totalCars = cars.Count;
            var activeCars = cars.Count(c => string.Equals(c.Status, "Active", StringComparison.OrdinalIgnoreCase));

            var totalDeals = deals.Count;
            var completedDealsCount = completedDeals.Count;
            var totalRevenue = completedDeals.Sum(d => d.Price);
            var averageCarPrice = totalCars > 0 ? cars.Average(c => c.Price) : 0;

            var topBrands = cars
                .GroupBy(c => string.IsNullOrWhiteSpace(c.BrandName) ? "Неизвестно" : c.BrandName!)
                .Select(g => new BrandStatDto
                {
                    BrandName = g.Key,
                    Count = g.Count()
                })
                .OrderByDescending(x => x.Count)
                .Take(10)
                .ToList();

            var dealsByMonth = completedDeals
                .Select(d => d.CompletedAt ?? d.CreatedAt)
                .GroupBy(d => new { d.Year, d.Month })
                .OrderBy(g => g.Key.Year)
                .ThenBy(g => g.Key.Month)
                .Select(g => new DealByMonthDto
                {
                    Year = g.Key.Year,
                    MonthNumber = g.Key.Month,
                    Month = $"{g.Key.Year}-{g.Key.Month:00}",
                    Count = g.Count(),
                    Revenue = completedDeals
                        .Where(d => (d.CompletedAt ?? d.CreatedAt).Year == g.Key.Year
                                 && (d.CompletedAt ?? d.CreatedAt).Month == g.Key.Month)
                        .Sum(d => d.Price)
                })
                .ToList();

            var carsByPriceRange = cars
                .GroupBy(c => c.Price < 1000000 ? "<1м" :
                              c.Price < 2000000 ? "1-2м" :
                              c.Price < 3000000 ? "2-3м" :
                              c.Price < 5000000 ? "3-5м" : "5м+")
                .Select(g => new PriceRangeDto
                {
                    Range = g.Key,
                    Count = g.Count()
                })
                .OrderBy(x => x.Range)
                .ToList();

            return new StatisticsDto
            {
                TotalCars = totalCars,
                ActiveCars = activeCars,
                TotalDeals = totalDeals,
                CompletedDeals = completedDealsCount,
                TotalRevenue = totalRevenue,
                AverageCarPrice = averageCarPrice,
                TopBrands = topBrands,
                DealsByMonth = dealsByMonth,
                CarsByPriceRange = carsByPriceRange
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error building statistics from data: {ex.Message}");
            return null;
        }
    }

    private Task ExportReport()
    {
        Console.WriteLine("Exporting report...");
        return Task.CompletedTask;
    }
}

