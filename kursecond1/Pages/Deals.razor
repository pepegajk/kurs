@page "/deals"
@inject ApiService ApiService
@inject AuthService AuthService
@inject UserSettingsService SettingsService
@inject IJSRuntime JSRuntime

<PageTitle>Сделки - AutoMarket</PageTitle>

<div class="page-header">
    <h1><span class="bi bi-clipboard-check-fill"></span> Сделки</h1>
    <button class="btn btn-primary" @onclick="ExportToCSV">
        <span class="bi bi-download"></span> Экспорт CSV
    </button>
</div>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
        <p class="mt-2">Загрузка сделок...</p>
    </div>
}
else
{
    <div class="filters-panel">
        <div class="row g-3">
            <div class="col-md-4">
                <select class="form-select" @onchange="OnFilterStatusChanged">
                    <option value="">Все статусы</option>
                    <option value="Created" selected="@(filterStatus == "Created")">Сделка создана</option>
                    <option value="UnderReview" selected="@(filterStatus == "UnderReview")">На рассмотрении</option>
                    <option value="InProgress" selected="@(filterStatus == "InProgress")">В работе</option>
                    <option value="Completed" selected="@(filterStatus == "Completed")">Завершен</option>
                    <option value="Cancelled" selected="@(filterStatus == "Cancelled")">Отменен</option>
                </select>
            </div>
            <div class="col-md-3">
                <input type="date" class="form-control" value="@filterDateFrom?.ToString("yyyy-MM-dd")" @onchange="OnFilterDateFromChanged" />
            </div>
            <div class="col-md-3">
                <input type="date" class="form-control" value="@filterDateTo?.ToString("yyyy-MM-dd")" @onchange="OnFilterDateToChanged" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">
                    Сбросить
                </button>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Автомобиль</th>
                    <th>Продавец</th>
                    <th>Покупатель</th>
                    <th>Цена</th>
                    <th>Комиссия</th>
                    <th>Статус</th>
                    <th>Дата создания</th>
                    <th>Дата завершения</th>
                    @if (AuthService.IsAdmin || AuthService.IsManager)
                    {
                        <th>Действия</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var deal in filteredDeals)
                {
                    <tr>
                        <td>@deal.Id</td>
                        <td>@GetCarDisplay(deal)</td>
                        <td>@GetUserDisplay(deal.SellerId, deal.SellerName)</td>
                        <td>@GetUserDisplay(deal.BuyerId, deal.BuyerName)</td>
                        <td>@SettingsService.FormatPrice(deal.Price)</td>
                        <td>
                            @if (deal.CommissionAmount.HasValue)
                            {
                                @SettingsService.FormatPrice(deal.CommissionAmount.Value)
                                @if (deal.CommissionPercent.HasValue)
                                {
                                    <small>(@deal.CommissionPercent.Value%)</small>
                                }
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>
                            <span class="badge @GetStatusBadgeClass(deal.Status)">
                                @GetStatusText(deal.Status)
                            </span>
                        </td>
                        <td>@SettingsService.FormatDate(deal.CreatedAt)</td>
                        <td>
                            @if (deal.CompletedAt.HasValue)
                            {
                                @SettingsService.FormatDate(deal.CompletedAt.Value)
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        @if (AuthService.IsAdmin || AuthService.IsManager)
                        {
                            <td>
                                <div class="btn-group" role="group">
                                    @if (deal.Status == "Created" || deal.Status == "UnderReview")
                                    {
                                        <button class="btn btn-sm btn-success" @onclick="@(() => ApproveDeal(deal.Id))" title="Утвердить сделку">
                                            <span class="bi bi-check-circle"></span> Утвердить
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-primary" @onclick="@(() => OpenEditDeal(deal.Id))">
                                        <span class="bi bi-pencil"></span> Редактировать
                                    </button>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (filteredDeals.Count == 0)
    {
        <div class="alert alert-info text-center my-4">
            <span class="bi bi-info-circle"></span> Сделки не найдены.
        </div>
    }

    <div class="stats-bar mt-4">
        <div class="row">
            <div class="col-md-3">
                <strong>Найдено:</strong> @filteredDeals.Count из @deals.Count
            </div>
            <div class="col-md-3">
                <strong>Завершено:</strong> @filteredDeals.Count(d => d.Status == "Completed")
            </div>
            <div class="col-md-3">
                <strong>В работе:</strong> @filteredDeals.Count(d => d.Status == "InProgress" || d.Status == "UnderReview")
            </div>
            <div class="col-md-3">
                <strong>Общая сумма:</strong> @SettingsService.FormatPrice(filteredDeals.Sum(d => d.Price))
            </div>
        </div>
    </div>

    @if (showEditModal)
    {
        <div class="modal show d-block deal-modal-backdrop" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content deal-modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Редактировать сделку №@editingDeal.Id</h5>
                        <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (isEditLoading)
                        {
                            <div class="text-center py-3">
                                <div class="spinner-border text-primary"></div>
                            </div>
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(editError))
                            {
                                <div class="alert alert-danger" role="alert">
                                    <span class="bi bi-exclamation-triangle"></span> @editError
                                </div>
                            }

                            <div class="deal-info-grid">
                                <div>
                                    <div class="form-label">Автомобиль</div>
                                    <div class="deal-info-value">@GetCarDisplay(editingDeal)</div>
                                </div>
                                <div>
                                    <div class="form-label">Покупатель</div>
                                    <div class="deal-info-value">@GetUserDisplay(editingDeal.BuyerId, editingDeal.BuyerName)</div>
                                </div>
                                <div>
                                    <div class="form-label">Продавец</div>
                                    <div class="deal-info-value">@GetUserDisplay(editingDeal.SellerId, editingDeal.SellerName)</div>
                                </div>
                                <div>
                                    <div class="form-label">Цена</div>
                                    <div class="deal-info-value">@SettingsService.FormatPrice(editingDeal.Price)</div>
                                </div>
                            </div>

                            <div class="mt-3">
                                <label class="form-label">Статус</label>
                                <select class="form-select" @bind="editingDeal.Status">
                                    @foreach (var status in GetAllAvailableStatuses())
                                    {
                                        <option value="@status">@GetStatusText(status)</option>
                                    }
                                    @if (!GetAllAvailableStatuses().Contains(editingDeal.Status))
                                    {
                                        <option value="@editingDeal.Status">@editingDeal.Status</option>
                                    }
                                </select>
                            </div>
                            <div class="mt-3">
                                <label class="form-label">Примечание</label>
                                <textarea class="form-control" rows="3" @bind="editingDeal.Notes"></textarea>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseEditModal" disabled="@isSaving">Отмена</button>
                        <button type="button" class="btn btn-primary" @onclick="SaveEditDeal" disabled="@(isSaving || isEditLoading)">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Сохранение...</span>
                            }
                            else
                            {
                                <span class="bi bi-save"></span>
                                <span>Сохранить</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<DealDto> deals = new();
    private List<DealDto> filteredDeals = new();
    private List<CarDto> cars = new();
    private List<BrandDto> brands = new();
    private List<ModelDto> models = new();
    private Dictionary<string, AdminUserDto> usersById = new();
    private bool isLoading = true;

    private bool showEditModal = false;
    private bool isEditLoading = false;
    private bool isSaving = false;
    private string editError = string.Empty;
    private DealDto editingDeal = new();
    
    private string filterStatus = "";
    private DateTime? filterDateFrom;
    private DateTime? filterDateTo;

    protected override async Task OnInitializedAsync()
    {
        await LoadDeals();
    }

    private async Task LoadDeals()
    {
        isLoading = true;
        try
        {
            var dealsTask = ApiService.GetDealsAsync();
            var carsTask = ApiService.GetCarsAsync();
            var brandsTask = ApiService.GetBrandsAsync();
            var modelsTask = ApiService.GetModelsAsync();
            var usersTask = AuthService.IsAdmin
                ? ApiService.GetUsersAsync()
                : Task.FromResult(new List<AdminUserDto>());

            await Task.WhenAll(dealsTask, carsTask, brandsTask, modelsTask, usersTask);

            deals = dealsTask.Result;
            cars = carsTask.Result;
            brands = brandsTask.Result;
            models = modelsTask.Result;
            usersById = usersTask.Result
                .Where(u => !string.IsNullOrWhiteSpace(u.Id))
                .ToDictionary(u => u.Id, u => u);

            FilterDeals();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading deals: {ex.Message}");
            deals = new List<DealDto>();
            filteredDeals = new List<DealDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnFilterStatusChanged(ChangeEventArgs e)
    {
        filterStatus = e.Value?.ToString() ?? "";
        FilterDeals();
    }

    private void OnFilterDateFromChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            filterDateFrom = date;
        }
        else
        {
            filterDateFrom = null;
        }
        FilterDeals();
    }

    private void OnFilterDateToChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            filterDateTo = date;
        }
        else
        {
            filterDateTo = null;
        }
        FilterDeals();
    }

    private void FilterDeals()
    {
        filteredDeals = deals.Where(d =>
            (string.IsNullOrEmpty(filterStatus) || d.Status == filterStatus) &&
            (!filterDateFrom.HasValue || d.CreatedAt.Date >= filterDateFrom.Value.Date) &&
            (!filterDateTo.HasValue || d.CreatedAt.Date <= filterDateTo.Value.Date)
        ).ToList();
    }

    private void ClearFilters()
    {
        filterStatus = "";
        filterDateFrom = null;
        filterDateTo = null;
        FilterDeals();
    }

    [Inject] private ExportService ExportService { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private async Task ExportToCSV()
    {
        try
        {
            var csvData = ExportService.ExportDealsToCsv(filteredDeals);
            var fileName = $"deals_export_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await JS.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(csvData), "text/csv");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Export error: {ex.Message}");
        }
    }

    private async Task OpenEditDeal(int dealId)
    {
        showEditModal = true;
        isEditLoading = true;
        editError = string.Empty;

        try
        {
            var deal = await ApiService.GetDealByIdAsync(dealId);
            if (deal != null)
            {
                editingDeal = deal;
            }
            else
            {
                editingDeal = deals.FirstOrDefault(d => d.Id == dealId) ?? new DealDto();
            }
        }
        catch (Exception ex)
        {
            editError = $"Ошибка загрузки сделки: {ex.Message}";
            editingDeal = deals.FirstOrDefault(d => d.Id == dealId) ?? new DealDto();
        }
        finally
        {
            isEditLoading = false;
        }
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editError = string.Empty;
        editingDeal = new DealDto();
    }

    private async Task SaveEditDeal()
    {
        if (editingDeal.Id <= 0)
        {
            editError = "Сделка не выбрана.";
            return;
        }

        isSaving = true;
        editError = string.Empty;

        try
        {
            if (editingDeal.Status == "Completed" && !editingDeal.CompletedAt.HasValue)
            {
                editingDeal.CompletedAt = DateTime.UtcNow;
            }
            else if (editingDeal.Status != "Completed")
            {
                editingDeal.CompletedAt = null;
            }

            var success = await ApiService.UpdateDealAsync(editingDeal.Id, editingDeal);
            if (success)
            {
                await LoadDeals();
                CloseEditModal();
            }
            else
            {
                editError = "Не удалось сохранить изменения.";
            }
        }
        catch (Exception ex)
        {
            editError = $"Ошибка сохранения: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetCarDisplay(DealDto deal)
    {
        if (!string.IsNullOrWhiteSpace(deal.CarInfo))
        {
            return deal.CarInfo;
        }

        return GetCarDisplay(deal.CarId);
    }

    private string GetCarDisplay(int carId)
    {
        var car = cars.FirstOrDefault(c => c.Id == carId);
        if (car == null)
        {
            return $"Автомобиль ID: {carId}";
        }

        if (!string.IsNullOrWhiteSpace(car.BrandName) || !string.IsNullOrWhiteSpace(car.ModelName))
        {
            return $"{car.BrandName} {car.ModelName} {car.Year}".Trim();
        }

        var model = models.FirstOrDefault(m => m.Id == car.ModelId);
        if (model != null)
        {
            var brand = brands.FirstOrDefault(b => b.Id == model.BrandId);
            if (brand != null)
            {
                return $"{brand.Name} {model.Name} {car.Year}".Trim();
            }

            return $"{model.Name} {car.Year}".Trim();
        }

        return $"Автомобиль ID: {carId}";
    }

    private string GetUserDisplay(string? userId, string? name)
    {
        if (!string.IsNullOrWhiteSpace(name))
        {
            return name;
        }

        if (!string.IsNullOrWhiteSpace(userId) && usersById.TryGetValue(userId, out var user))
        {
            var fullName = $"{user.FirstName} {user.LastName}".Trim();
            if (!string.IsNullOrWhiteSpace(fullName))
            {
                return fullName;
            }

            if (!string.IsNullOrWhiteSpace(user.Email))
            {
                return user.Email;
            }
        }

        return !string.IsNullOrWhiteSpace(userId) ? userId : "-";
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-secondary",
            "Created" => "bg-info",
            "UnderReview" => "bg-warning",
            "InProgress" => "bg-primary",
            "In Work" => "bg-primary",
            "Completed" => "bg-success",
            "Cancelled" => "bg-danger",
            "Canceled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetStatusText(string status)
    {
        return status switch
        {
            "Pending" => "В ожидании",
            "Created" => "Сделка создана",
            "UnderReview" => "На рассмотрении",
            "InProgress" => "В работе",
            "In Work" => "В работе",
            "Completed" => "Завершен",
            "Cancelled" => "Отменен",
            "Canceled" => "Отменен",
            _ => status
        };
    }

    private string[] GetAllAvailableStatuses()
    {
        return new[] { "Pending", "Created", "UnderReview", "InProgress", "Completed", "Cancelled" };
    }

    private async Task ApproveDeal(int dealId)
    {
        var deal = deals.FirstOrDefault(d => d.Id == dealId);
        if (deal == null)
            return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"Утвердить сделку №{dealId}? Статус будет изменен на 'В работе'.");
        
        if (!confirmed)
            return;

        try
        {
            // Используем специальный метод для утверждения сделки
            var success = await ApiService.ApproveDealAsync(dealId);
            if (success)
            {
                await LoadDeals();
                StateHasChanged();
            }
            else
            {
                // Если специального метода нет, используем обновление
                var updatedDeal = new DealDto
                {
                    Id = deal.Id,
                    CarId = deal.CarId,
                    SellerId = deal.SellerId,
                    BuyerId = deal.BuyerId,
                    Price = deal.Price,
                    CommissionAmount = deal.CommissionAmount,
                    CommissionPercent = deal.CommissionPercent,
                    Status = "InProgress", // Утвержденная сделка переходит в работу
                    Notes = deal.Notes,
                    CreatedAt = deal.CreatedAt,
                    CompletedAt = deal.CompletedAt,
                    ApprovedBy = AuthService.CurrentUser?.UserId
                };

                success = await ApiService.UpdateDealAsync(dealId, updatedDeal);
                if (success)
                {
                    await LoadDeals();
                    StateHasChanged();
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Не удалось утвердить сделку.");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error approving deal: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка: {ex.Message}");
        }
    }
}

<style>
    .deal-modal-backdrop {
        background-color: rgba(0, 0, 0, 0.5);
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1050;
    }

    .deal-modal-content {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        border: 1px solid var(--border-color);
    }

    .deal-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .deal-info-value {
        background-color: var(--bg-secondary);
        color: var(--text-primary);
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius-sm);
        padding: 0.5rem 0.75rem;
        min-height: 38px;
        display: flex;
        align-items: center;
    }

    @@media (max-width: 768px) {
        .deal-info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
