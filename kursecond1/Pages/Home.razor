@page "/"
@inject ApiService ApiService
@inject NavigationManager Navigation

<PageTitle>AutoMarket - Платформа продажи автомобилей</PageTitle>

<!-- Hero Section -->
<section class="hero-section text-white py-5 mb-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-3">Найдите автомобиль своей мечты</h1>
                <p class="lead mb-4">Более @totalCars автомобилей от проверенных дилеров по всей России</p>
                <a href="/cars" class="btn btn-light btn-lg">
                    <i class="bi bi-search"></i> Смотреть каталог
                </a>
            </div>
            <div class="col-lg-6 text-center">
                <i class="bi bi-car-front-fill" style="font-size: 12rem; opacity: 0.3;"></i>
            </div>
        </div>
    </div>
</section>

<!-- Статистика -->
<section class="stats-section py-4 mb-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon bg-primary">
                        <i class="bi bi-car-front-fill"></i>
                    </div>
                    <h3>@totalCars</h3>
                    <p>Автомобилей</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon bg-success">
                        <i class="bi bi-award-fill"></i>
                    </div>
                    <h3>@totalBrands</h3>
                    <p>Брендов</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon bg-info">
                        <i class="bi bi-clipboard-check-fill"></i>
                    </div>
                    <h3>@totalDeals</h3>
                    <p>Сделок</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon bg-warning">
                        <i class="bi bi-star-fill"></i>
                    </div>
                    @if (averageRating > 0)
                    {
                        <h3>@averageRating.ToString("0.0")/5</h3>
                    }
                    else
                    {
                        <h3>—</h3>
                    }
                    <p>Рейтинг</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- О платформе -->
<section class="about-section py-5 mb-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <h2 class="mb-4 text-center">О нашей платформе</h2>
                <p class="lead text-center">AutoMarket — это современная платформа для покупки и продажи автомобилей, объединяющая покупателей и проверенных дилеров.</p>
                <ul class="list-unstyled mt-4">
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                        <strong>Только проверенные дилеры</strong> - все продавцы проходят верификацию
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                        <strong>Безопасные сделки</strong> - защита покупателя на каждом этапе
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                        <strong>Прозрачные цены</strong> - никаких скрытых комиссий
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                        <strong>Широкий выбор</strong> - большой каталог автомобилей
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Популярные автомобили -->
<section class="popular-section py-5 mb-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Популярные предложения</h2>
            <a href="/cars" class="btn btn-outline-primary">
                Смотреть все <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        
        @if (isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary"></div>
                <p class="mt-2 text-muted">Загрузка автомобилей...</p>
            </div>
        }
        else if (featuredCars.Any())
        {
            <div class="row g-4">
                @foreach (var car in featuredCars)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm car-card-home" @onclick="@(() => Navigation.NavigateTo($"/cars/{car.Id}"))">
                            <div class="card-img-placeholder">
                                <i class="bi bi-car-front-fill"></i>
                            </div>
                            
                            @if (car.IsFeatured)
                            {
                                <span class="badge bg-warning position-absolute top-0 end-0 m-2">
                                    <i class="bi bi-star-fill"></i> VIP
                                </span>
                            }
                            
                            <div class="card-body">
                                <h6 class="card-title fw-bold">@car.BrandName @car.ModelName</h6>
                                <p class="text-muted small mb-2">
                                    <i class="bi bi-calendar"></i> @car.Year г • 
                                    <i class="bi bi-speedometer2"></i> @car.Mileage.ToString("N0") км
                                </p>
                                @{
                                    var carRating = GetCarRating(car.Id);
                                }
                                @if (carRating.HasValue)
                                {
                                    <div class="mb-2">
                                        <span class="text-warning">
                                            @for (int i = 0; i < 5; i++)
                                            {
                                                <i class="bi @(i < Math.Round(carRating.Value) ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </span>
                                        <span class="text-muted small ms-1">@carRating.Value.ToString("0.0")</span>
                                    </div>
                                }
                                <h5 class="text-primary mb-2">@car.Price.ToString("N0") ₽</h5>
                                <div class="d-flex justify-content-between text-muted small">
                                    <span><i class="bi bi-fuel-pump"></i> @car.FuelType</span>
                                    <span><i class="bi bi-geo-alt"></i> @car.Location</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Загрузите данные из API для отображения автомобилей
            </div>
        }
    </div>
</section>

<!-- Преимущества -->
<section class="features-section py-5 mb-5">
    <div class="container">
        <h2 class="text-center mb-5">Почему выбирают AutoMarket</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card text-center p-4">
                    <i class="bi bi-shield-check feature-icon text-primary"></i>
                    <h4 class="mt-3">Безопасность сделок</h4>
                    <p class="text-muted">Проверка всех документов и юридическая чистота автомобилей. Гарантия возврата денег.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center p-4">
                    <i class="bi bi-speedometer2 feature-icon text-success"></i>
                    <h4 class="mt-3">Быстрый подбор</h4>
                    <p class="text-muted">Умные фильтры и поиск помогут найти идеальный автомобиль за несколько минут.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center p-4">
                    <i class="bi bi-headset feature-icon text-info"></i>
                    <h4 class="mt-3">Поддержка 24/7</h4>
                    <p class="text-muted">Наши менеджеры всегда готовы помочь вам в выборе и оформлении сделки.</p>
                </div>
            </div>
        </div>
    </div>
</section>


<style>
    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }

    .stat-card {
        background: var(--bg-primary);
        padding: 2rem;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        text-align: center;
        transition: transform 0.3s;
        border: 1px solid var(--border-color);
    }

    .stat-card:hover {
        transform: translateY(-5px);
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        color: white;
    }

    .stat-icon i {
        font-size: 2rem;
    }

    .stat-card h3 {
        font-size: 2rem;
        font-weight: bold;
        margin: 0.5rem 0;
        color: var(--text-primary);
    }

    .stat-card p {
        color: var(--text-secondary);
        margin: 0;
    }


    .car-card-home {
        cursor: pointer;
        transition: all 0.3s ease;
        border-radius: 12px;
        overflow: hidden;
    }

    .car-card-home:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2) !important;
    }

    .card-img-placeholder {
        height: 180px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 4rem;
        opacity: 0.8;
    }

    .feature-card {
        background: var(--bg-primary);
        transition: transform 0.3s;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        color: var(--text-primary);
    }

    .feature-card:hover {
        transform: translateY(-10px);
        box-shadow: var(--shadow-lg);
    }

    .feature-card h4 {
        color: var(--text-primary);
    }

    .feature-card p {
        color: var(--text-secondary);
    }

    .feature-icon {
        font-size: 3.5rem;
    }


    @@media (max-width: 768px) {
        .hero-section h1 {
            font-size: 2rem;
        }

        .stat-card h3 {
            font-size: 1.5rem;
        }

    }
</style>

@code {
    private int totalCars = 0;
    private int totalBrands = 0;
    private int totalDeals = 0;
    private double averageRating = 0.0;
    private List<CarDto> featuredCars = new();
    private Dictionary<int, double?> carRatings = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
    }

    private async Task LoadStats()
    {
        isLoading = true;
        try
        {
            var cars = await ApiService.GetCarsAsync();
            var brands = await ApiService.GetBrandsAsync();
            var deals = await ApiService.GetDealsAsync();

            totalCars = cars.Count;
            totalBrands = brands.Count;
            totalDeals = deals.Count;

            // Берём 4 избранных автомобиля для отображения
            featuredCars = cars.Where(c => c.IsFeatured || c.Status == "Active")
                              .Take(4)
                              .ToList();

            // Вычисляем средний рейтинг по всем одобренным отзывам
            await CalculateAverageRating(cars);
            
            // Загружаем рейтинги для featured cars
            await LoadCarRatings(featuredCars);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stats: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CalculateAverageRating(List<CarDto> cars)
    {
        try
        {
            var allRatings = new List<int>();
            
            // Получаем отзывы для всех автомобилей
            foreach (var car in cars)
            {
                var reviews = await ApiService.GetReviewsByCarAsync(car.Id);
                var approvedRatings = reviews.Where(r => r.IsApproved).Select(r => r.Rating);
                allRatings.AddRange(approvedRatings);
            }
            
            if (allRatings.Any())
            {
                averageRating = allRatings.Average();
            }
            else
            {
                averageRating = 0.0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating average rating: {ex.Message}");
            averageRating = 0.0;
        }
    }

    private async Task LoadCarRatings(List<CarDto> cars)
    {
        try
        {
            foreach (var car in cars)
            {
                var reviews = await ApiService.GetReviewsByCarAsync(car.Id);
                var approvedRatings = reviews.Where(r => r.IsApproved).Select(r => r.Rating).ToList();
                
                if (approvedRatings.Any())
                {
                    carRatings[car.Id] = approvedRatings.Average();
                }
                else
                {
                    carRatings[car.Id] = null;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading car ratings: {ex.Message}");
        }
    }

    private double? GetCarRating(int carId)
    {
        return carRatings.ContainsKey(carId) ? carRatings[carId] : null;
    }

}
