@code {
    private string activeTab = "brands";
    private bool isLoading = false;
    
    private List<BrandDto> brands = new();
    private List<ModelDto> models = new();
    private List<CarDto> cars = new();
    private List<AdminUserDto> users = new();
    private List<CarImageDto> allCarImages = new();
    private bool isLoadingImages = false;
    private int selectedCarIdForImages = 0;
    private string userSearchQuery = "";
    
    // Orders management
    private List<DealDto> orders = new();
    private string orderStatusFilter = "";

    // Image upload modal for car-images tab
    private bool showImageUploadModal = false;
    private int imageUploadCarId = 0;
    private string newImageUrlForUpload = string.Empty;
    private IBrowserFile? selectedFileForUpload;
    private string? uploadErrorForTab = null;
    private bool isUploadingForTab = false;

    [Inject] private IJSRuntime JSRuntime { get; set; } = null!;

    private string GetCarModelName(CarDto car)
    {
        if (!string.IsNullOrEmpty(car.BrandName) || !string.IsNullOrEmpty(car.ModelName))
        {
            return $"{car.BrandName} {car.ModelName}".Trim();
        }
        
        // Если BrandName и ModelName не загружены, пытаемся найти модель по ModelId
        var model = models.FirstOrDefault(m => m.Id == car.ModelId);
        if (model != null)
        {
            var brand = brands.FirstOrDefault(b => b.Id == model.BrandId);
            return $"{brand?.Name} {model.Name}".Trim();
        }
        
        return "Не указано";
    }

    // Brand modal
    private bool showBrandModal = false;
    private BrandDto editingBrand = new();

    // Model modal
    private bool showModelModal = false;
    private ModelDto editingModel = new();

    // Car modal
    private bool showCarModal = false;
    private CarDto editingCar = new();
    private List<CarImageDto> carImages = new();
    private string newImageUrl = string.Empty;
    private IBrowserFile? selectedFile;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        if (activeTab == "car-images")
        {
            await LoadCarImagesForManagement();
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            brands = await ApiService.GetBrandsAsync();
            models = await ApiService.GetModelsAsync();
            cars = await ApiService.GetCarsAsync();
            users = await ApiService.GetUsersAsync();
            orders = await ApiService.GetDealsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        if (tab == "car-images")
        {
            _ = LoadCarImagesForManagement();
        }
        else if (tab == "orders")
        {
            _ = LoadData();
        }
    }

    // Brand methods
    private void ShowBrandModal(BrandDto? brand)
    {
        editingBrand = brand != null ? new BrandDto
        {
            Id = brand.Id,
            Name = brand.Name,
            Description = brand.Description,
            Country = brand.Country,
            LogoUrl = brand.LogoUrl,
            IsActive = brand.IsActive
        } : new BrandDto { IsActive = true };
        showBrandModal = true;
    }

    private void CloseBrandModal()
    {
        showBrandModal = false;
        editingBrand = new();
    }

    private async Task SaveBrand()
    {
        bool success;
        if (editingBrand.Id > 0)
        {
            success = await ApiService.UpdateBrandAsync(editingBrand.Id, editingBrand);
        }
        else
        {
            success = await ApiService.CreateBrandAsync(editingBrand);
        }

        if (success)
        {
            CloseBrandModal();
            await LoadData();
            StateHasChanged();
        }
    }

    private async Task DeleteBrand(int id)
    {
        if (await ApiService.DeleteBrandAsync(id))
        {
            await LoadData();
            StateHasChanged();
        }
    }

    // Model methods
    private void ShowModelModal(ModelDto? model)
    {
        editingModel = model != null ? new ModelDto
        {
            Id = model.Id,
            BrandId = model.BrandId,
            Name = model.Name,
            Description = model.Description,
            YearFrom = model.YearFrom,
            YearTo = model.YearTo,
            IsActive = model.IsActive
        } : new ModelDto { IsActive = true };
        showModelModal = true;
    }

    private void CloseModelModal()
    {
        showModelModal = false;
        editingModel = new();
    }

    private async Task SaveModel()
    {
        bool success;
        if (editingModel.Id > 0)
        {
            success = await ApiService.UpdateModelAsync(editingModel.Id, editingModel);
        }
        else
        {
            success = await ApiService.CreateModelAsync(editingModel);
        }

        if (success)
        {
            CloseModelModal();
            await LoadData();
            StateHasChanged();
        }
    }

    private async Task DeleteModel(int id)
    {
        if (await ApiService.DeleteModelAsync(id))
        {
            await LoadData();
            StateHasChanged();
        }
    }

    // Car methods
    private async Task ShowCarModal(CarDto? car)
    {
        editingCar = car != null ? new CarDto
        {
            Id = car.Id,
            ModelId = car.ModelId,
            Year = car.Year,
            Price = car.Price,
            Mileage = car.Mileage,
            BodyType = car.BodyType,
            FuelType = car.FuelType,
            Transmission = car.Transmission,
            Location = car.Location,
            Description = car.Description,
            Status = car.Status
        } : new CarDto { Status = "Active" };
        
        if (editingCar.Id > 0)
        {
            carImages = await ApiService.GetCarImagesAsync(editingCar.Id);
        }
        else
        {
            carImages = new();
        }
        
        newImageUrl = string.Empty;
        showCarModal = true;
    }

    private void CloseCarModal()
    {
        showCarModal = false;
        editingCar = new();
        carImages = new();
        newImageUrl = string.Empty;
        selectedFile = null;
        uploadError = null;
        isUploading = false;
    }

    private async Task AddCarImage()
    {
        if (string.IsNullOrWhiteSpace(newImageUrl) || editingCar.Id <= 0)
            return;

        var newImage = new CarImageDto
        {
            CarId = editingCar.Id,
            ImageUrl = newImageUrl,
            DisplayOrder = carImages.Count,
            IsMain = carImages.Count == 0
        };

        if (await ApiService.CreateCarImageAsync(newImage))
        {
            carImages = await ApiService.GetCarImagesAsync(editingCar.Id);
            newImageUrl = string.Empty;
            StateHasChanged();
        }
    }

    private string? uploadError = null;
    private bool isUploading = false;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        uploadError = null;
        
        if (e.File == null)
        {
            selectedFile = null;
            StateHasChanged();
            return;
        }

        // Проверка типа файла
        if (!e.File.ContentType.StartsWith("image/"))
        {
            uploadError = "Выберите файл изображения (JPG, PNG, GIF и т.д.)";
            selectedFile = null;
            StateHasChanged();
            return;
        }

        // Проверка размера файла (максимум 10 МБ)
        const long maxFileSize = 10 * 1024 * 1024; // 10 МБ
        if (e.File.Size > maxFileSize)
        {
            uploadError = $"Размер файла превышает 10 МБ. Текущий размер: {(e.File.Size / 1024.0 / 1024.0):F2} МБ";
            selectedFile = null;
            StateHasChanged();
            return;
        }

        selectedFile = e.File;
        StateHasChanged();
    }

    private async Task UploadImageFile()
    {
        if (selectedFile == null || editingCar.Id <= 0)
            return;

        isUploading = true;
        uploadError = null;
        StateHasChanged();

        try
        {
            // Открываем поток файла и загружаем через multipart/form-data
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            
            if (await ApiService.UploadCarImageFileAsync(editingCar.Id, stream, selectedFile.Name, selectedFile.ContentType))
            {
                carImages = await ApiService.GetCarImagesAsync(editingCar.Id);
                selectedFile = null;
                uploadError = null;
                StateHasChanged();
            }
            else
            {
                uploadError = "Не удалось загрузить изображение. Убедитесь, что API поддерживает загрузку файлов или используйте вариант с URL.";
            }
        }
        catch (Exception ex)
        {
            uploadError = $"Ошибка при загрузке файла: {ex.Message}";
            Console.WriteLine($"Error uploading file: {ex.Message}");
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private async Task DeleteCarImage(int imageId)
    {
        try
        {
            if (editingCar.Id <= 0)
            {
                Console.WriteLine("No car selected for deletion");
                return;
            }

            // Подтверждение удаления
            if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Вы уверены, что хотите удалить это изображение?"))
            {
                return;
            }

            var success = await ApiService.DeleteCarImageAsync(editingCar.Id, imageId);
            if (success)
            {
                carImages = await ApiService.GetCarImagesAsync(editingCar.Id);
                StateHasChanged();
            }
            else
            {
                Console.WriteLine($"Failed to delete image {imageId}");
                await JSRuntime.InvokeVoidAsync("alert", "Ошибка при удалении изображения.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in DeleteCarImage: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка: {ex.Message}");
        }
    }

    private async Task SetMainImage(int imageId)
    {
        try
        {
            var success = await ApiService.SetMainImageAsync(imageId);
            if (success)
            {
                carImages = await ApiService.GetCarImagesAsync(editingCar.Id);
                StateHasChanged();
            }
            else
            {
                Console.WriteLine($"Failed to set main image {imageId}");
                await JSRuntime.InvokeVoidAsync("alert", "Ошибка при установке главного изображения.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in SetMainImage: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка: {ex.Message}");
        }
    }

    private async Task SaveCar()
    {
        bool success;
        if (editingCar.Id > 0)
        {
            success = await ApiService.UpdateCarAsync(editingCar.Id, editingCar);
        }
        else
        {
            success = await ApiService.CreateCarAsync(editingCar);
        }

        if (success)
        {
            CloseCarModal();
            await LoadData();
            StateHasChanged();
        }
    }

    private async Task DeleteCar(int id)
    {
        if (await ApiService.DeleteCarAsync(id))
        {
            await LoadData();
            StateHasChanged();
        }
    }

    private string GetStatusBadge(string status)
    {
        return status switch
        {
            "Active" => "bg-success",
            "Sold" => "bg-info",
            "Inactive" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private async Task ToggleUserActive(string userId)
    {
        if (await ApiService.ToggleUserActiveAsync(userId))
        {
            await LoadData();
            StateHasChanged();
        }
    }

    private List<AdminUserDto> GetFilteredUsers()
    {
        if (string.IsNullOrWhiteSpace(userSearchQuery))
            return users;

        return users.Where(u => 
            u.Email.Contains(userSearchQuery, StringComparison.OrdinalIgnoreCase) ||
            (u.FirstName?.Contains(userSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (u.LastName?.Contains(userSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false)
        ).ToList();
    }

    private async Task OnCarIdForImagesChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var carId))
        {
            selectedCarIdForImages = carId;
        }
        else
        {
            selectedCarIdForImages = 0;
        }
        await LoadCarImagesForManagement();
    }

    private async Task LoadCarImagesForManagement()
    {
        isLoadingImages = true;
        StateHasChanged();

        try
        {
            if (selectedCarIdForImages > 0)
            {
                // Загружаем фото только для выбранного авто
                allCarImages = await ApiService.GetCarImagesAsync(selectedCarIdForImages);
            }
            else
            {
                // Загружаем фото для всех авто
                allCarImages = new List<CarImageDto>();
                foreach (var car in cars)
                {
                    var images = await ApiService.GetCarImagesAsync(car.Id);
                    allCarImages.AddRange(images);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading car images: {ex.Message}");
            allCarImages = new List<CarImageDto>();
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка при загрузке изображений: {ex.Message}");
        }
        finally
        {
            isLoadingImages = false;
            StateHasChanged();
        }
    }

    private async Task SetMainImageForManagement(int imageId)
    {
        try
        {
            Console.WriteLine($"SetMainImageForManagement called with imageId: {imageId}");
            var image = allCarImages.FirstOrDefault(img => img.Id == imageId);
            if (image == null)
            {
                Console.WriteLine($"Image {imageId} not found in allCarImages");
                await JSRuntime.InvokeVoidAsync("alert", $"Изображение {imageId} не найдено");
                return;
            }

            Console.WriteLine($"Setting main image: {imageId} for car: {image.CarId}");
            var success = await ApiService.SetMainImageAsync(imageId);
            Console.WriteLine($"SetMainImageAsync returned: {success}");
            
            if (success)
            {
                await LoadCarImagesForManagement();
                await Task.Delay(100); // Небольшая задержка для обновления
                StateHasChanged();
                Console.WriteLine("StateHasChanged called after setting main image");
            }
            else
            {
                Console.WriteLine($"Failed to set main image {imageId}");
                await JSRuntime.InvokeVoidAsync("alert", "Ошибка при установке главного изображения. Проверьте консоль.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in SetMainImageForManagement: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка: {ex.Message}");
        }
    }

    private async Task DeleteCarImageForManagement(int imageId)
    {
        try
        {
            Console.WriteLine($"DeleteCarImageForManagement called with imageId: {imageId}");
            var image = allCarImages.FirstOrDefault(img => img.Id == imageId);
            if (image == null)
            {
                Console.WriteLine($"Image {imageId} not found in allCarImages");
                await JSRuntime.InvokeVoidAsync("alert", $"Изображение {imageId} не найдено");
                return;
            }

            // Подтверждение удаления
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Вы уверены, что хотите удалить это изображение?");
            Console.WriteLine($"User confirmed deletion: {confirmed}");
            if (!confirmed)
            {
                return;
            }

            Console.WriteLine($"Deleting image: {imageId} for car: {image.CarId}");
            var success = await ApiService.DeleteCarImageAsync(image.CarId, imageId);
            Console.WriteLine($"DeleteCarImageAsync returned: {success}");
            
            if (success)
            {
                await LoadCarImagesForManagement();
                await Task.Delay(100); // Небольшая задержка для обновления
                StateHasChanged();
                Console.WriteLine("StateHasChanged called after deletion");
            }
            else
            {
                Console.WriteLine($"Failed to delete image {imageId}");
                await JSRuntime.InvokeVoidAsync("alert", "Ошибка при удалении изображения. Проверьте консоль браузера (F12).");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in DeleteCarImageForManagement: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка: {ex.Message}");
        }
    }

    private void ShowImageUploadModal(int carId)
    {
        imageUploadCarId = carId;
        newImageUrlForUpload = string.Empty;
        selectedFileForUpload = null;
        uploadErrorForTab = null;
        isUploadingForTab = false;
        showImageUploadModal = true;
    }

    private void CloseImageUploadModal()
    {
        showImageUploadModal = false;
        imageUploadCarId = 0;
        newImageUrlForUpload = string.Empty;
        selectedFileForUpload = null;
        uploadErrorForTab = null;
        isUploadingForTab = false;
    }

    private async Task OnFileSelectedForTab(InputFileChangeEventArgs e)
    {
        uploadErrorForTab = null;
        
        if (e.File == null)
        {
            selectedFileForUpload = null;
            StateHasChanged();
            return;
        }

        if (!e.File.ContentType.StartsWith("image/"))
        {
            uploadErrorForTab = "Выберите файл изображения (JPG, PNG, GIF и т.д.)";
            selectedFileForUpload = null;
            StateHasChanged();
            return;
        }

        const long maxFileSize = 10 * 1024 * 1024;
        if (e.File.Size > maxFileSize)
        {
            uploadErrorForTab = $"Размер файла превышает 10 МБ. Текущий размер: {(e.File.Size / 1024.0 / 1024.0):F2} МБ";
            selectedFileForUpload = null;
            StateHasChanged();
            return;
        }

        selectedFileForUpload = e.File;
        StateHasChanged();
    }

    private async Task UploadImageFileForTab()
    {
        if (selectedFileForUpload == null || imageUploadCarId <= 0)
            return;

        isUploadingForTab = true;
        uploadErrorForTab = null;
        StateHasChanged();

        try
        {
            using var stream = selectedFileForUpload.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            
            if (await ApiService.UploadCarImageFileAsync(imageUploadCarId, stream, selectedFileForUpload.Name, selectedFileForUpload.ContentType))
            {
                await LoadCarImagesForManagement();
                CloseImageUploadModal();
            }
            else
            {
                uploadErrorForTab = "Не удалось загрузить изображение. Попробуйте использовать вариант с URL.";
            }
        }
        catch (Exception ex)
        {
            uploadErrorForTab = $"Ошибка при загрузке файла: {ex.Message}";
            Console.WriteLine($"Error uploading file: {ex.Message}");
        }
        finally
        {
            isUploadingForTab = false;
            StateHasChanged();
        }
    }

    private async Task AddCarImageByUrlForTab()
    {
        if (string.IsNullOrWhiteSpace(newImageUrlForUpload) || imageUploadCarId <= 0)
            return;

        var newImage = new CarImageDto
        {
            CarId = imageUploadCarId,
            ImageUrl = newImageUrlForUpload,
            DisplayOrder = 0,
            IsMain = false
        };

        if (await ApiService.CreateCarImageAsync(newImage))
        {
            await LoadCarImagesForManagement();
            CloseImageUploadModal();
        }
        else
        {
            uploadErrorForTab = "Не удалось добавить изображение. Проверьте URL.";
        }
    }

    // Orders management methods
    private void OnOrderStatusFilterChanged(ChangeEventArgs e)
    {
        orderStatusFilter = e.Value?.ToString() ?? "";
        StateHasChanged();
    }

    private List<DealDto> GetFilteredOrders()
    {
        if (string.IsNullOrEmpty(orderStatusFilter))
            return orders;
        
        return orders.Where(o => o.Status == orderStatusFilter).ToList();
    }

    private async Task OnOrderStatusChange(int orderId, ChangeEventArgs e)
    {
        var newStatus = e.Value?.ToString();
        if (string.IsNullOrEmpty(newStatus))
            return;

        var order = orders.FirstOrDefault(o => o.Id == orderId);
        if (order == null)
            return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"Изменить статус сделки №{orderId} на '{GetOrderStatusText(newStatus)}'?");
        
        if (!confirmed)
        {
            // Возвращаем старое значение
            StateHasChanged();
            return;
        }

        try
        {
            var success = await ApiService.UpdateDealStatusAsync(orderId, newStatus);
            if (success)
            {
                await LoadData();
                StateHasChanged();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Ошибка при изменении статуса сделки.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating deal status: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка: {ex.Message}");
        }
    }

    private string GetOrderStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-secondary",
            "Created" => "bg-info",
            "UnderReview" => "bg-warning",
            "InProgress" => "bg-primary",
            "In Work" => "bg-primary",
            "Completed" => "bg-success",
            "Cancelled" => "bg-danger",
            "Canceled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetOrderStatusText(string status)
    {
        return status switch
        {
            "Pending" => "В ожидании",
            "Created" => "Сделка создана",
            "UnderReview" => "На рассмотрении",
            "InProgress" => "В работе",
            "In Work" => "В работе",
            "Completed" => "Завершен",
            "Cancelled" => "Отменен",
            "Canceled" => "Отменен",
            _ => status
        };
    }
    
    private string[] GetAllAvailableStatuses()
    {
        // Возвращаем все возможные статусы (и существующие в БД, и новые)
        return new[] { "Pending", "Created", "UnderReview", "InProgress", "Completed", "Cancelled" };
    }
}

