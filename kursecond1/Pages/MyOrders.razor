@page "/my-orders"

@inject ApiService ApiService
@inject AuthService AuthService
@inject UserSettingsService SettingsService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Мои сделки - AutoMarket</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="alert alert-warning">
        <span class="bi bi-exclamation-triangle"></span> Необходимо войти в систему для просмотра сделок.
        <button class="btn btn-link" @onclick="@(() => Navigation.NavigateTo("/login"))">Войти</button>
    </div>
}
else
{
    <div class="page-header">
        <h1><span class="bi bi-cart-check"></span> Мои сделки</h1>
    </div>

    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="mt-2">Загрузка сделок...</p>
        </div>
    }
    else if (!orders.Any())
    {
        <div class="alert alert-info">
            <span class="bi bi-info-circle"></span> У вас пока нет сделок. 
            <a href="/cars" class="alert-link">Перейти к каталогу автомобилей</a>
        </div>
    }
    else
    {
        <div class="orders-container">
            @foreach (var order in orders.OrderByDescending(o => o.CreatedAt))
            {
                <div class="order-card mb-4">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-0">Сделка №@order.Id</h5>
                                <small class="text-muted">Создан: @SettingsService.FormatDate(order.CreatedAt)</small>
                            </div>
                            <span class="badge @GetStatusBadgeClass(order.Status)">@GetStatusText(order.Status)</span>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-8">
                                    <h6>Автомобиль</h6>
                                    <p class="mb-2">
                                        <strong>@GetCarFullName(order.CarId)</strong>
                                    </p>
                                    <a href="/cars/@order.CarId" class="btn btn-sm btn-outline-primary">
                                        <span class="bi bi-eye"></span> Посмотреть детали
                                    </a>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <h6>Сумма сделки</h6>
                                    <p class="h5 text-primary mb-0">@SettingsService.FormatPrice(order.Price)</p>
                                </div>
                            </div>
                            
                            @if (order.Status == "UnderReview" || order.Status == "InProgress")
                            {
                                <hr />
                                <div class="order-timeline">
                                    <div class="timeline-item @(order.Status == "Created" ? "active" : "completed")">
                                        <span class="timeline-icon">✓</span>
                                        <span class="timeline-text">Сделка создана</span>
                                        <span class="timeline-date">@SettingsService.FormatDate(order.CreatedAt)</span>
                                    </div>
                                    <div class="timeline-item @(order.Status == "UnderReview" ? "active" : order.Status == "InProgress" || order.Status == "Completed" ? "completed" : "")">
                                        <span class="timeline-icon">✓</span>
                                        <span class="timeline-text">На рассмотрении менеджера</span>
                                    </div>
                                    <div class="timeline-item @(order.Status == "InProgress" ? "active" : order.Status == "Completed" ? "completed" : "")">
                                        <span class="timeline-icon">✓</span>
                                        <span class="timeline-text">В работе у дилера</span>
                                    </div>
                                    <div class="timeline-item @(order.Status == "Completed" ? "active completed" : "")">
                                        <span class="timeline-icon">✓</span>
                                        <span class="timeline-text">Завершен</span>
                                        @if (order.CompletedAt.HasValue)
                                        {
                                            <span class="timeline-date">@SettingsService.FormatDate(order.CompletedAt.Value)</span>
                                        }
                                    </div>
                                </div>
                            }
                            
                            @if (!string.IsNullOrEmpty(order.Notes))
                            {
                                <hr />
                                <div class="alert alert-info mb-0">
                                    <strong>Примечание:</strong> @order.Notes
                                </div>
                            }
                            
                            @if (order.Status == "Completed")
                            {
                                var hasReview = HasReviewForDeal(order.Id);
                                var review = hasReview ? GetReviewForDeal(order.Id) : null;
                                
                                <hr />
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        @if (hasReview && review != null)
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="text-success">
                                                    <span class="bi bi-check-circle"></span> Отзыв оставлен
                                                </span>
                                                <div class="review-rating-small">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <span class="bi @(i <= review.Rating ? "bi-star-fill text-warning" : "bi-star text-muted")" style="font-size: 0.9rem;"></span>
                                                    }
                                                </div>
                                                @if (review.IsApproved)
                                                {
                                                    <span class="badge bg-success">Одобрен</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">На модерации</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                <span class="bi bi-star"></span> Оставьте отзыв о покупке
                                            </span>
                                        }
                                    </div>
                                    @if (!hasReview)
                                    {
                                        <button class="btn btn-primary btn-sm" @onclick="() => ShowReviewModal(order.Id)">
                                            <span class="bi bi-star-fill"></span> Оставить отзыв
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Модальное окно для создания отзыва -->
    @if (isReviewModalVisible)
    {
        <div class="modal show" style="display: block; background: rgba(0,0,0,0.5);" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content review-modal-content">
                    <div class="modal-header review-modal-header">
                        <h5 class="modal-title">
                            <span class="bi bi-star-fill text-warning me-2"></span> Оставить отзыв
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseReviewModal" aria-label="Закрыть"></button>
                    </div>
                    <div class="modal-body review-modal-body">
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                Рейтинг <span class="text-danger">*</span>
                            </label>
                            <div class="rating-selector mt-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    var starRating = i;
                                    <span class="star-rating-btn @(starRating <= reviewRating ? "active" : "")" 
                                          @onclick="() => { reviewRating = starRating; StateHasChanged(); }"
                                          @onmouseover="() => hoverRating = starRating"
                                          @onmouseout="() => hoverRating = 0"
                                          role="button"
                                          tabindex="0"
                                          @onkeypress="@((KeyboardEventArgs e) => { if (e.Key == "Enter") { reviewRating = starRating; StateHasChanged(); } })">
                                        <span class="bi @((hoverRating > 0 ? starRating <= hoverRating : starRating <= reviewRating) ? "bi-star-fill text-warning" : "bi-star text-muted")" 
                                              style="font-size: 2.5rem; transition: all 0.2s;"></span>
                                    </span>
                                }
                                <span class="ms-3 align-middle rating-text">
                                    <strong>@reviewRating</strong> из 5
                                </span>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Комментарий</label>
                            <textarea class="form-control review-textarea" rows="5" 
                                      @bind="reviewComment" 
                                      @bind:event="oninput"
                                      maxlength="1000"
                                      placeholder="Расскажите о вашем опыте покупки... Поделитесь своими впечатлениями."></textarea>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <small class="text-muted">
                                    <span class="bi bi-info-circle"></span> Поле необязательное, но мы будем рады вашим отзывам
                                </small>
                                <small class="text-muted @(reviewComment.Length > 900 ? "text-warning" : "")">
                                    <span class="@(reviewComment.Length > 1000 ? "text-danger" : "")">@reviewComment.Length</span> / 1000 символов
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer review-modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseReviewModal" disabled="@isSubmittingReview">
                            <span class="bi bi-x-lg"></span> Отмена
                        </button>
                        <button type="button" class="btn btn-primary btn-lg" @onclick="SubmitReview" disabled="@isSubmittingReview">
                            @if (isSubmittingReview)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Отправка...</span>
                            }
                            else
                            {
                                <span class="bi bi-send me-2"></span>
                                <span>Отправить</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop show" style="opacity: 0.5;"></div>
    }
}

<style>
    .orders-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .order-card .card {
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow);
        transition: all 0.3s ease;
    }

    .order-card .card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
    }

    .order-timeline {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1rem 0;
    }

    .timeline-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.5rem;
        border-radius: var(--border-radius-sm);
        opacity: 0.5;
        transition: opacity 0.3s;
    }

    .timeline-item.active {
        opacity: 1;
        background: var(--bg-secondary);
        font-weight: 600;
    }

    .timeline-item.completed {
        opacity: 1;
    }

    .timeline-icon {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--border-color);
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        flex-shrink: 0;
    }

    .timeline-item.active .timeline-icon {
        background: var(--primary-color);
        color: white;
    }

    .timeline-item.completed .timeline-icon {
        background: var(--success-color);
        color: white;
    }

    .timeline-text {
        flex: 1;
    }

    .timeline-date {
        color: var(--text-secondary);
        font-size: 0.875rem;
    }

    @@media (max-width: 768px) {
        .order-timeline {
            font-size: 0.875rem;
        }
    }

    .review-rating-small {
        display: inline-flex;
        gap: 0.1rem;
    }

    .review-modal-content {
        border: none;
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
    }

    .review-modal-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 12px 12px 0 0;
        border-bottom: none;
        padding: 1.25rem 1.5rem;
    }

    .review-modal-header .modal-title {
        font-size: 1.5rem;
        font-weight: 600;
    }

    .review-modal-body {
        padding: 2rem;
        background: #f8f9fa;
    }

    .review-modal-footer {
        border-top: 1px solid #dee2e6;
        padding: 1.25rem 1.5rem;
        background: white;
        border-radius: 0 0 12px 12px;
    }

    .rating-selector {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 1rem;
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .star-rating-btn {
        cursor: pointer;
        transition: all 0.2s ease;
        padding: 0.25rem;
        border-radius: 4px;
    }

    .star-rating-btn:hover {
        transform: scale(1.15);
        background: rgba(255, 193, 7, 0.1);
    }

    .star-rating-btn.active {
        background: rgba(255, 193, 7, 0.15);
    }

    .rating-text {
        font-size: 1.1rem;
        color: #495057;
    }

    .review-textarea {
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 1rem;
        font-size: 1rem;
        transition: border-color 0.3s;
        resize: vertical;
        min-height: 120px;
    }

    .review-textarea:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        outline: none;
    }

    .modal.show {
        display: flex !important;
        align-items: center;
        justify-content: center;
    }

    .modal.show .modal-dialog {
        margin: 0;
    }

    .btn-lg {
        padding: 0.75rem 1.5rem;
        font-size: 1.1rem;
        font-weight: 500;
    }
</style>

@code {
    private List<DealDto> orders = new();
    private List<CarDto> cars = new();
    private List<BrandDto> brands = new();
    private List<ModelDto> models = new();
    private List<ReviewDto> reviews = new();
    private bool isLoading = true;
    
    // Модальное окно для создания отзыва
    private bool isReviewModalVisible = false;
    private int selectedDealId = 0;
    private int reviewRating = 5;
    private int hoverRating = 0;
    private string reviewComment = "";
    private bool isSubmittingReview = false;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            await LoadOrders();
            await LoadReviews();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        try
        {
            // Загружаем сделки
            orders = await ApiService.GetMyDealsAsync();
            Console.WriteLine($"Loaded {orders.Count} deals for current user");
            
            // Загружаем автомобили, бренды и модели для отображения названий
            cars = await ApiService.GetCarsAsync();
            brands = await ApiService.GetBrandsAsync();
            models = await ApiService.GetModelsAsync();
            
            // Заполняем CarInfo для каждой сделки, если оно пустое
            foreach (var order in orders)
            {
                if (string.IsNullOrEmpty(order.CarInfo))
                {
                    order.CarInfo = GetCarFullName(order.CarId);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading deals: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка при загрузке сделок: {ex.Message}");
            orders = new List<DealDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadReviews()
    {
        try
        {
            // Загружаем свои отзывы (включая неодобренные)
            reviews = await ApiService.GetMyReviewsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading reviews: {ex.Message}");
        }
    }

    private bool HasReviewForDeal(int dealId)
    {
        if (!reviews.Any()) return false;
        
        var currentUserId = AuthService.CurrentUser?.UserId;
        if (string.IsNullOrEmpty(currentUserId)) return false;
        
        return reviews.Any(r => r.DealId == dealId && r.AuthorId == currentUserId);
    }

    private ReviewDto? GetReviewForDeal(int dealId)
    {
        var currentUserId = AuthService.CurrentUser?.UserId;
        if (string.IsNullOrEmpty(currentUserId)) return null;
        
        return reviews.FirstOrDefault(r => r.DealId == dealId && r.AuthorId == currentUserId);
    }

    private void ShowReviewModal(int dealId)
    {
        selectedDealId = dealId;
        reviewRating = 5;
        reviewComment = "";
        isReviewModalVisible = true;
        StateHasChanged();
    }

    private void CloseReviewModal()
    {
        isReviewModalVisible = false;
        selectedDealId = 0;
        reviewRating = 5;
        reviewComment = "";
        StateHasChanged();
    }

    private async Task SubmitReview()
    {
        if (selectedDealId == 0 || reviewRating < 1 || reviewRating > 5)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Пожалуйста, выберите рейтинг от 1 до 5");
            return;
        }

        isSubmittingReview = true;
        try
        {
            var success = await ApiService.CreateReviewAsync(selectedDealId, reviewRating, reviewComment);
            
            if (success)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Отзыв успешно отправлен на модерацию!");
                CloseReviewModal();
                await LoadReviews(); // Обновляем список отзывов
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Ошибка при создании отзыва. Проверьте, что сделка завершена и вы ещё не оставляли отзыв.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error submitting review: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Ошибка при создании отзыва: {ex.Message}");
        }
        finally
        {
            isSubmittingReview = false;
        }
    }
    
    private string GetCarFullName(int carId)
    {
        var car = cars.FirstOrDefault(c => c.Id == carId);
        if (car == null)
        {
            return $"Автомобиль ID: {carId}";
        }
        
        // Если в CarDto есть BrandName и ModelName
        if (!string.IsNullOrEmpty(car.BrandName) && !string.IsNullOrEmpty(car.ModelName))
        {
            return $"{car.BrandName} {car.ModelName} {car.Year}";
        }
        
        // Иначе ищем через ModelId
        var model = models.FirstOrDefault(m => m.Id == car.ModelId);
        if (model != null)
        {
            var brand = brands.FirstOrDefault(b => b.Id == model.BrandId);
            if (brand != null)
            {
                return $"{brand.Name} {model.Name} {car.Year}";
            }
            return $"{model.Name} {car.Year}";
        }
        
        return $"Автомобиль ID: {carId}";
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-secondary",
            "Created" => "bg-info",
            "UnderReview" => "bg-warning",
            "InProgress" => "bg-primary",
            "In Work" => "bg-primary",
            "Completed" => "bg-success",
            "Cancelled" => "bg-danger",
            "Canceled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetStatusText(string status)
    {
        return status switch
        {
            "Pending" => "В ожидании",
            "Created" => "Сделка создана",
            "UnderReview" => "На рассмотрении",
            "InProgress" => "В работе",
            "In Work" => "В работе",
            "Completed" => "Завершен",
            "Cancelled" => "Отменен",
            "Canceled" => "Отменен",
            _ => status
        };
    }
}

