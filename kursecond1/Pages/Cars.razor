@page "/cars"
@page "/cars/model/{ModelId:int}"

@inject ApiService ApiService
@inject UserSettingsService SettingsService
@inject NavigationManager Navigation

@using kursecond1.Models

<PageTitle>Автомобили - AutoMarket</PageTitle>

<div class="page-header">
    <h1>
        <span class="bi bi-car-front-fill"></span> Автомобили
        @if (ModelId.HasValue || filterModelId.HasValue)
        {
            var modelIdToFilter = ModelId ?? filterModelId;
            var modelName = models.FirstOrDefault(m => m.Id == modelIdToFilter.Value)?.Name;
            if (!string.IsNullOrEmpty(modelName))
            {
                <span class="text-muted">- @modelName</span>
            }
        }
    </h1>
    @if (ModelId.HasValue || filterModelId.HasValue)
    {
        <button class="btn btn-secondary me-2" @onclick="@(() => Navigation.NavigateTo("/cars"))">
            <span class="bi bi-x-lg"></span> Сбросить фильтр
        </button>
    }
    <button class="btn btn-primary" @onclick="ExportToCSV">
        <span class="bi bi-download"></span> Экспорт CSV
    </button>
</div>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
        <p class="mt-2">Загрузка автомобилей...</p>
    </div>
}
else
{
    <div class="filters-panel">
        <div class="row g-3">
            <div class="col-md-3">
                <input type="text" class="form-control" placeholder="🔍 Поиск по названию, модели, производителю, описанию..." 
                       @bind="searchQuery" @bind:event="oninput" @onkeyup="FilterCars" />
            </div>
            <div class="col-md-2">
                <select class="form-select" @onchange="OnFilterStatusChanged">
                    <option value="">Все статусы</option>
                    <option value="Active" selected="@(filterStatus == "Active")">Активные</option>
                    <option value="Sold" selected="@(filterStatus == "Sold")">Проданные</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Сортировка:</label>
                <select class="form-select" @onchange="OnSortChanged">
                    <option value="default" selected="@(sortBy == "default")">По умолчанию</option>
                    <option value="rating-desc" selected="@(sortBy == "rating-desc")">По рейтингу (высокий)</option>
                    <option value="rating-asc" selected="@(sortBy == "rating-asc")">По рейтингу (низкий)</option>
                    <option value="reviews-desc" selected="@(sortBy == "reviews-desc")">По количеству отзывов</option>
                    <option value="price-asc" selected="@(sortBy == "price-asc")">По цене (возрастание)</option>
                    <option value="price-desc" selected="@(sortBy == "price-desc")">По цене (убывание)</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" @onchange="OnFilterFuelTypeChanged">
                    <option value="">Все типы топлива</option>
                    <option value="Бензин" selected="@(filterFuelType == "Бензин")">Бензин</option>
                    <option value="Дизель" selected="@(filterFuelType == "Дизель")">Дизель</option>
                    <option value="Гибрид" selected="@(filterFuelType == "Гибрид")">Гибрид</option>
                    <option value="Электро" selected="@(filterFuelType == "Электро")">Электро</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">
                    Сбросить фильтры
                </button>
            </div>
        </div>
    </div>

    <div class="stats-bar">
        <span>Найдено: <strong>@filteredCars.Count</strong> из @cars.Count</span>
    </div>

    <div class="cars-grid">
        @foreach (var car in GetPagedCars())
        {
            var carImage = carImagesDict.ContainsKey(car.Id) ? carImagesDict[car.Id] : null;
            <div class="car-card" @onclick="@(() => ViewCarDetails(car.Id))">
                <div class="car-card-image">
                    @if (carImage != null)
                    {
                        <img src="@ApiService.GetImageUrl(carImage.ImageUrl)" alt="@($"{car.BrandName} {car.ModelName}")" 
                             onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="car-image-placeholder" style="display: none;">
                            <span class="bi bi-image"></span>
                            <span>Нет фото</span>
                        </div>
                    }
                    else
                    {
                        <div class="car-image-placeholder">
                            <span class="bi bi-image"></span>
                            <span>Нет фото</span>
                        </div>
                    }
                    <div class="car-card-badges">
                        @if (car.IsFeatured)
                        {
                            <span class="badge bg-warning">⭐ Рекомендуем</span>
                        }
                        <span class="badge @GetStatusBadgeClass(car.Status)">@car.Status</span>
                    </div>
                </div>
                <div class="car-card-body">
                    <h3 class="car-title">
                        @GetCarFullName(car)
                    </h3>
                    <div class="car-year-price">
                        <span class="car-year">@car.Year год</span>
                        <span class="car-price">@SettingsService.FormatPrice(car.Price)</span>
                    </div>
                    
                    <div class="car-specs-grid">
                        <div class="spec-item">
                            <span class="bi bi-speedometer2"></span>
                            <span class="spec-label">Пробег:</span>
                            <span class="spec-value">@car.Mileage.ToString("N0") км</span>
                        </div>
                        @if (car.EngineVolume.HasValue)
                        {
                            <div class="spec-item">
                                <span class="bi bi-gear-fill"></span>
                                <span class="spec-label">Двигатель:</span>
                                <span class="spec-value">@car.EngineVolume.Value.ToString("0.0") л</span>
                            </div>
                        }
                        @if (car.EnginePower.HasValue)
                        {
                            <div class="spec-item">
                                <span class="bi bi-lightning-charge"></span>
                                <span class="spec-label">Мощность:</span>
                                <span class="spec-value">@car.EnginePower.Value л.с.</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(car.BodyType))
                        {
                            <div class="spec-item">
                                <span class="bi bi-car-front"></span>
                                <span class="spec-label">Кузов:</span>
                                <span class="spec-value">@car.BodyType</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(car.FuelType))
                        {
                            <div class="spec-item">
                                <span class="bi bi-fuel-pump"></span>
                                <span class="spec-label">Топливо:</span>
                                <span class="spec-value">@car.FuelType</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(car.Transmission))
                        {
                            <div class="spec-item">
                                <span class="bi bi-gear"></span>
                                <span class="spec-label">КПП:</span>
                                <span class="spec-value">@car.Transmission</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(car.DriveType))
                        {
                            <div class="spec-item">
                                <span class="bi bi-diagram-3"></span>
                                <span class="spec-label">Привод:</span>
                                <span class="spec-value">@car.DriveType</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(car.Color))
                        {
                            <div class="spec-item">
                                <span class="bi bi-palette"></span>
                                <span class="spec-label">Цвет:</span>
                                <span class="spec-value">@car.Color</span>
                            </div>
                        }
                    </div>
                    
                    <div class="car-location">
                        <span class="bi bi-geo-alt-fill"></span> @car.Location
                    </div>
                    
                    <div class="car-footer">
                        <div class="car-stats">
                            <span class="bi bi-eye"></span> @car.ViewsCount просмотров
                            @{
                                var (avgRating, reviewCount) = GetCarRating(car.Id);
                            }
                            @if (reviewCount > 0)
                            {
                                <span class="ms-2">
                                    <span class="bi bi-star-fill text-warning"></span>
                                    <strong>@avgRating.ToString("F1")</strong>
                                    <span class="text-muted">(@reviewCount)</span>
                                </span>
                            }
                            else
                            {
                                <span class="ms-2 text-muted small">
                                    <span class="bi bi-star"></span> Нет отзывов
                                </span>
                            }
                        </div>
                        @if (car.Condition == "New")
                        {
                            <span class="badge bg-success">Новый</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (filteredCars.Count == 0)
    {
        <div class="alert alert-info text-center my-4">
            <span class="bi bi-info-circle"></span> Автомобили не найдены. Попробуйте изменить фильтры.
        </div>
    }

    @if (totalPages > 1)
    {
        <div class="pagination-container">
            <nav>
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" @onclick="@(() => ChangePage(currentPage - 1))">Назад</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        var pageNum = i;
                        <li class="page-item @(currentPage == pageNum ? "active" : "")">
                            <a class="page-link" @onclick="@(() => ChangePage(pageNum))">@pageNum</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" @onclick="@(() => ChangePage(currentPage + 1))">Вперёд</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
}

@code {
    [Parameter]
    public int? ModelId { get; set; }
    
    private List<CarDto> cars = new();
    private List<CarDto> filteredCars = new();
    private List<BrandDto> brands = new();
    private List<ModelDto> models = new();
    private bool isLoading = true;
    
    private string searchQuery = "";
    private string filterStatus = "";
    private string filterFuelType = "";
    private string sortBy = "default";
    private int? filterModelId = null;
    
    private int currentPage = 1;
    private int pageSize => SettingsService.GetSettings().PageSize;
    private int totalPages => (int)Math.Ceiling((double)filteredCars.Count / pageSize);
    
    // Словарь для хранения рейтингов по автомобилям (carId -> (averageRating, reviewCount))
    private Dictionary<int, (double averageRating, int reviewCount)> carRatings = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCars();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ModelId.HasValue)
        {
            filterModelId = ModelId.Value;
        }
        else
        {
            filterModelId = null;
        }
        await LoadCars();
        // Загружаем изображения для текущей страницы
        await LoadImagesForCurrentPageAsync();
    }

    private Dictionary<int, CarImageDto> carImagesDict = new();

    private async Task LoadCars()
    {
        isLoading = true;
        
        // Загружаем бренды и модели для определения названий
        brands = await ApiService.GetBrandsAsync();
        models = await ApiService.GetModelsAsync();
        
        cars = await ApiService.GetCarsAsync();
        
        // Если BrandName и ModelName не загружены, заполняем их из списков
        foreach (var car in cars)
        {
            if (string.IsNullOrEmpty(car.BrandName) || string.IsNullOrEmpty(car.ModelName))
            {
                var model = models.FirstOrDefault(m => m.Id == car.ModelId);
                if (model != null)
                {
                    car.ModelName = model.Name;
                    var brand = brands.FirstOrDefault(b => b.Id == model.BrandId);
                    if (brand != null)
                    {
                        car.BrandName = brand.Name;
                    }
                }
            }
        }
        
        // Применяем фильтр по модели, если указан
        ApplyFilters();
        
        // Загружаем рейтинги для всех автомобилей
        await LoadCarRatings();
        
        // Загружаем изображения для текущей страницы
        await LoadImagesForCurrentPageAsync();
        
        isLoading = false;
    }

    private async Task LoadCarRatings()
    {
        carRatings.Clear();
        
        // Загружаем рейтинги параллельно для всех автомобилей
        var tasks = cars.Select(async car =>
        {
            try
            {
                var reviews = await ApiService.GetReviewsByCarAsync(car.Id);
                if (reviews.Any())
                {
                    var averageRating = reviews.Average(r => r.Rating);
                    var reviewCount = reviews.Count;
                    return (car.Id, averageRating, reviewCount);
                }
                else
                {
                    return (car.Id, 0.0, 0);
                }
            }
            catch
            {
                // Игнорируем ошибки загрузки отзывов
                return (car.Id, 0.0, 0);
            }
        });
        
        var results = await Task.WhenAll(tasks);
        foreach (var (carId, averageRating, reviewCount) in results)
        {
            carRatings[carId] = (averageRating, reviewCount);
        }
    }

    private (double averageRating, int reviewCount) GetCarRating(int carId)
    {
        return carRatings.ContainsKey(carId) ? carRatings[carId] : (0, 0);
    }

    private string GetCarFullName(CarDto car)
    {
        if (!string.IsNullOrEmpty(car.BrandName) && !string.IsNullOrEmpty(car.ModelName))
        {
            return $"{car.BrandName} {car.ModelName}";
        }
        
        // Если не загружены, пытаемся найти в списках
        var model = models.FirstOrDefault(m => m.Id == car.ModelId);
        if (model != null)
        {
            var brand = brands.FirstOrDefault(b => b.Id == model.BrandId);
            if (brand != null)
            {
                return $"{brand.Name} {model.Name}";
            }
            return model.Name;
        }
        
        return $"Автомобиль #{car.Id}";
    }

    private void ApplyFilters()
    {
        // Применяем фильтр по модели, если указан через URL параметр
        if (ModelId.HasValue)
        {
            filterModelId = ModelId.Value;
        }
        
        // Применяем все фильтры
        FilterCars();
    }

    private void OnFilterStatusChanged(ChangeEventArgs e)
    {
        filterStatus = e.Value?.ToString() ?? "";
        FilterCars();
    }

    private void OnFilterFuelTypeChanged(ChangeEventArgs e)
    {
        filterFuelType = e.Value?.ToString() ?? "";
        FilterCars();
    }

    private void OnSortChanged(ChangeEventArgs e)
    {
        sortBy = e.Value?.ToString() ?? "default";
        FilterCars();
    }

    private void FilterCars()
    {
        // Начинаем с фильтра по модели, если указан
        var filtered = cars.AsEnumerable();
        
        if (ModelId.HasValue || filterModelId.HasValue)
        {
            var modelIdToFilter = ModelId ?? filterModelId;
            filtered = filtered.Where(c => c.ModelId == modelIdToFilter.Value);
        }
        
        // Применяем остальные фильтры
        filtered = filtered.Where(c =>
        {
            // Фильтр по поисковому запросу
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var query = searchQuery.Trim();
                var found = false;
                
                // Поиск по VIN
                if (!string.IsNullOrEmpty(c.VIN) && c.VIN.Contains(query, StringComparison.OrdinalIgnoreCase))
                    found = true;
                
                // Поиск по бренду (производителю)
                if (!found && !string.IsNullOrEmpty(c.BrandName) && c.BrandName.Contains(query, StringComparison.OrdinalIgnoreCase))
                    found = true;
                
                // Поиск по модели
                if (!found && !string.IsNullOrEmpty(c.ModelName) && c.ModelName.Contains(query, StringComparison.OrdinalIgnoreCase))
                    found = true;
                
                // Поиск по полному названию (бренд + модель)
                if (!found && !string.IsNullOrEmpty(c.BrandName) && !string.IsNullOrEmpty(c.ModelName))
                {
                    var fullName = $"{c.BrandName} {c.ModelName}";
                    if (fullName.Contains(query, StringComparison.OrdinalIgnoreCase))
                        found = true;
                }
                
                // Поиск по описанию
                if (!found && !string.IsNullOrEmpty(c.Description) && c.Description.Contains(query, StringComparison.OrdinalIgnoreCase))
                    found = true;
                
                // Поиск по цвету
                if (!found && !string.IsNullOrEmpty(c.Color) && c.Color.Contains(query, StringComparison.OrdinalIgnoreCase))
                    found = true;
                
                // Поиск по типу кузова
                if (!found && !string.IsNullOrEmpty(c.BodyType) && c.BodyType.Contains(query, StringComparison.OrdinalIgnoreCase))
                    found = true;
                
                // Поиск по типу топлива
                if (!found && !string.IsNullOrEmpty(c.FuelType) && c.FuelType.Contains(query, StringComparison.OrdinalIgnoreCase))
                    found = true;
                
                // Поиск по типу коробки передач
                if (!found && !string.IsNullOrEmpty(c.Transmission) && c.Transmission.Contains(query, StringComparison.OrdinalIgnoreCase))
                    found = true;
                
                // Поиск по приводу
                if (!found && !string.IsNullOrEmpty(c.DriveType) && c.DriveType.Contains(query, StringComparison.OrdinalIgnoreCase))
                    found = true;
                
                // Поиск по локации
                if (!found && !string.IsNullOrEmpty(c.Location) && c.Location.Contains(query, StringComparison.OrdinalIgnoreCase))
                    found = true;
                
                // Поиск по регистрационному номеру
                if (!found && !string.IsNullOrEmpty(c.RegistrationNumber) && c.RegistrationNumber.Contains(query, StringComparison.OrdinalIgnoreCase))
                    found = true;
                
                if (!found)
                    return false;
            }
            
            // Фильтр по статусу
            if (!string.IsNullOrEmpty(filterStatus) && c.Status != filterStatus)
                return false;
            
            // Фильтр по типу топлива
            if (!string.IsNullOrEmpty(filterFuelType) && c.FuelType != filterFuelType)
                return false;
            
            return true;
        });

        // Применяем сортировку
        filteredCars = sortBy switch
        {
            "rating-desc" => filtered.OrderByDescending(c => GetCarRating(c.Id).averageRating).ToList(),
            "rating-asc" => filtered.OrderBy(c => GetCarRating(c.Id).averageRating).ToList(),
            "reviews-desc" => filtered.OrderByDescending(c => GetCarRating(c.Id).reviewCount).ToList(),
            "price-asc" => filtered.OrderBy(c => c.Price).ToList(),
            "price-desc" => filtered.OrderByDescending(c => c.Price).ToList(),
            _ => filtered.ToList()
        };
        
        currentPage = 1;
        
        // Загружаем изображения для автомобилей на текущей странице после фильтрации
        _ = LoadImagesForCurrentPageAsync();
    }

    private void ClearFilters()
    {
        searchQuery = "";
        filterStatus = "";
        filterFuelType = "";
        FilterCars();
    }

    private List<CarDto> GetPagedCars()
    {
        return filteredCars
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            // Загружаем изображения для автомобилей на новой странице
            _ = LoadImagesForCurrentPageAsync();
        }
    }

    private async Task LoadImagesForCurrentPageAsync()
    {
        var carsOnPage = GetPagedCars();
        foreach (var car in carsOnPage)
        {
            if (!carImagesDict.ContainsKey(car.Id))
            {
                await LoadCarImageAsync(car.Id);
            }
        }
        StateHasChanged(); // Обновляем UI после загрузки изображений
    }

    private async Task LoadCarImageAsync(int carId)
    {
        try
        {
            var mainImage = await ApiService.GetMainCarImageAsync(carId);
            if (mainImage != null)
            {
                carImagesDict[carId] = mainImage;
                StateHasChanged(); // Обновляем UI
            }
        }
        catch
        {
            // Игнорируем ошибки загрузки изображений (404 - изображения нет)
        }
    }

    private void ViewCarDetails(int carId)
    {
        Navigation.NavigateTo($"/cars/{carId}");
    }

    [Inject] private ExportService ExportService { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private async Task ExportToCSV()
    {
        try
        {
            var csvData = ExportService.ExportCarsToCsv(filteredCars);
            var fileName = $"cars_export_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await JS.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(csvData), "text/csv");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Export error: {ex.Message}");
        }
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Active" => "bg-success",
            "Sold" => "bg-secondary",
            "Reserved" => "bg-warning",
            _ => "bg-info"
        };
    }
}

