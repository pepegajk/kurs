CREATE OR REPLACE FUNCTION calculate_commission(deal_price DECIMAL, commission_percent DECIMAL DEFAULT 5.0)
RETURNS DECIMAL AS $$
BEGIN
    RETURN ROUND(deal_price * commission_percent / 100, 2);
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION update_timestamp()
RETURNS TRIGGER AS $$
BEGIN
    NEW."UpdatedAt" = NOW();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_update_cars_timestamp
BEFORE UPDATE ON "Cars"
FOR EACH ROW
EXECUTE FUNCTION update_timestamp();

CREATE VIEW "vw_cars_full" AS
SELECT
    c."Id",
    c."ModelId",
    m."Name" AS "ModelName",
    b."Name" AS "BrandName",
    c."Year",
    c."Price",
    c."Mileage",
    c."FuelType",
    c."Transmission",
    c."DriveType",
    c."EngineVolume",
    c."EnginePower",
    c."Color",
    c."BodyType",
    c."VIN",
    c."Location",
    c."Condition",
    c."Status",
    c."IsFeatured",
    c."ViewsCount",
    c."CreatedAt",
    c."UpdatedAt",
    u."Id" AS "SellerId",
    u."FirstName" AS "SellerFirstName",
    u."LastName" AS "SellerLastName",
    u."Email" AS "SellerEmail"
FROM "Cars" c
JOIN "Models" m ON m."Id" = c."ModelId"
JOIN "Brands" b ON b."Id" = m."BrandId"
JOIN "AspNetUsers" u ON u."Id" = c."SellerId";

CREATE VIEW "vw_active_cars" AS
SELECT *
FROM "vw_cars_full"
WHERE "Status" = 'Active';

